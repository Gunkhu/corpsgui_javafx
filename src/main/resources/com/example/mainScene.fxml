<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainController">
   <top>
      <Label text="Takarmány Táblázat" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <font>
            <Font size="17.0" />
         </font>
      </Label>
   </top>
   <center>
      <TableView fx:id="cropTable" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="109.0" text="Id" />
          <TableColumn fx:id="nameCol" prefWidth="140.0" text="Név" />
            <TableColumn fx:id="forageCol" prefWidth="105.0" text="Takarmány" />
            <TableColumn fx:id="quantityCol" prefWidth="145.0" text="Mennyiség" />
        </columns>
      </TableView>
   </center>
   <right>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="exitButton" mnemonicParsing="false" onAction="#onClickExitButton" prefWidth="100.0" text="Kilépés" />
            <Button mnemonicParsing="false" onAction="#onClickAboutButton" prefWidth="100.0" text="Névjegy" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
